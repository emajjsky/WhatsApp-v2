# Local development env (this file is safe to commit)

APP_NAME=whatsapp-agent-platform
APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

DB_DRIVER=postgres
DB_DSN=postgres://postgres:postgres@127.0.0.1:5432/whatsapp_agent_platform?sslmode=disable
DB_AUTO_MIGRATE=true
DB_MIGRATIONS_DIR=deploy/migrations

LOG_LEVEL=debug
LOG_FORMAT=text

# Integrations (Go API)
AGENT_RUNNER_BASE_URL=http://127.0.0.1:8090
WHATSAPP_PROXY_URL=

# Global safety switch: even if a rule is `auto_send`, auto dispatch is blocked unless this is true.
AGENT_AUTO_SEND_ENABLED=false

# agent_runner (Python)
AGENT_RUNNER_HOST=127.0.0.1
AGENT_RUNNER_PORT=8090
AGENT_RUNNER_DEFAULT_PROVIDER=openai_compatible

# OpenAI-compatible provider (agent_runner)
# Base URL can be either `https://host` or `https://host/v1` (we will normalize to `/v1`).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# If your compatible API uses a different model name, change it here.
OPENAI_COMPAT_MODEL=gpt-4o-mini
OPENAI_COMPAT_TEMPERATURE=0.2
OPENAI_COMPAT_MAX_TOKENS=320
OPENAI_COMPAT_TIMEOUT_SECONDS=25

