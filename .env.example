# Local development env (gitignored). Fill in your own values.

APP_NAME=whatsapp-agent-platform
APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

DB_DRIVER=postgres
DB_DSN=postgres://postgres:postgres@127.0.0.1:5432/whatsapp_agent_platform?sslmode=disable
DB_AUTO_MIGRATE=true
DB_MIGRATIONS_DIR=deploy/migrations

AUTH_COOKIE_NAME=wa_session
AUTH_SESSION_TTL=168h
AUTH_REGISTRATION_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin123456
AUTH_BOOTSTRAP_ADMIN_NAME=Administrator
AUTH_SECURE_COOKIE=false

LOG_LEVEL=debug
LOG_FORMAT=text

AGENT_RUNNER_BASE_URL=http://127.0.0.1:8090
WHATSAPP_PROXY_URL=
CLOUD_AUTH_BASE_URL=
AGENT_AUTO_SEND_ENABLED=true

AGENT_RUNNER_HOST=127.0.0.1
AGENT_RUNNER_PORT=8090
AGENT_RUNNER_DEFAULT_PROVIDER=mock
